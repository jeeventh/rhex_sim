FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];
internalField   uniform 278;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            inletOutlet;
        value           uniform 298;
        inletValue      uniform 298;
    }

    outlet
    {
        type            inletOutlet;
        value           uniform 278;
        inletValue      uniform 278;
    }

    thermalShell
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        Ta              constant 278;
        h               uniform 10.0;
        thicknessLayers (0.0005);
        kappaLayers     (50);
        kappaMethod     fluidThermo;
        value           $internalField;
    }
}


