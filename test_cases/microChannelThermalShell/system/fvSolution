FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers {
    "rho.*"

        {
        solver diagonal;
    }

    p_rgh {
        solver GAMG;
        tolerance 1e-06;
        relTol 0.1;
        smoother GaussSeidel;
    }

    p_rghFinal {
        solver GAMG;
        tolerance 1e-08;
        relTol 0;
        smoother GaussSeidel;
    }

    "(U|T|k|epsilon|omega|e)"

        {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-06;
        relTol 0.1;
    }

    "(U|T|k|epsilon|omega|e)Final"

        {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-08;
        relTol 0;
    }
}

PIMPLE {
    nOuterCorrectors 1;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;

    rhoMin 0.1;
    rhoMax 2.0;

    residualControl {
        p_rgh {
            tolerance 1e-4;
            relTol 0;
        }

        U {
            tolerance 1e-4;
            relTol 0;
        }

        T {
            tolerance 1e-4;
            relTol 0;
        }
    }
}

relaxationFactors {
    equations {
        ".*" 1;
    }
}

